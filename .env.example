# Copy to .env and fill in what you have. Each provider is independent: any one
# left blank keeps serving generated demo data, and the UI says so in a banner.
# The server does not hot-reload this file - restart `npm run dev` after edits.

# ── Sprout Social (owned social) ────────────────────────────────────────────
# Token: Sprout > Settings > Global Features > API > Generate API Token.
# `node tools/sprout-keys.mjs` prints the customer and group IDs.
SPROUT_API_TOKEN=
SPROUT_CUSTOMER_ID=2447399
SPROUT_GROUP_ID=2586729
SPROUT_GROUP_NAME=Alter Music
# Only if the Sprout group has artist-owned / fan-run sub-groups. Alter Music
# does not, so leave these blank and the app classifies from profile names.
SPROUT_ARTIST_GROUP_ID=
SPROUT_FAN_GROUP_ID=

# ── Chartmetric (consumption) ───────────────────────────────────────────────
# Chartmetric > Settings > API > refresh token. Artists resolve by name;
# pin chartmetricArtistId in config/artists.json when the lookup is wrong.
CHARTMETRIC_REFRESH_TOKEN=

# ── RealCount (live) ────────────────────────────────────────────────────────
# Both come from RealCount. Events are matched to roster names.
REALCOUNT_CLIENT_ID=
REALCOUNT_CLIENT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# PORT=8787                      # API port; the UI is always on :5173 in dev
# CACHE_TTL_SECONDS=900          # how long provider responses are cached
# OVERRIDES_PATH=                # where Accounts-tab corrections are saved
#                                # (default config/account-overrides.json; Render uses /var/data)
# ARTISTS_CONFIG=config/artists.json
