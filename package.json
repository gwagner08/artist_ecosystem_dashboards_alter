{
  "name": "artist-ecosystem-dashboards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firebird artist ecosystem dashboard - Sprout Social, Chartmetric and RealCount in one view, grouped by artist.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "verify:apis": "tsx server/src/verify.ts",
    "typecheck": "tsc --noEmit",
    "render-build": "npm ci --include=dev && npm run build",
    "check:chartmetric": "tsx server/src/check-chartmetric.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
